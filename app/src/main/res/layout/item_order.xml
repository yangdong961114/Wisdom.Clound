<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/shape_search_bg"
    android:layout_margin="10dp"
    android:padding="15dp">

    <!-- 订单编号 + 状态 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_order_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textColor="#333"
            android:text="订单号："/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/tv_order_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textColor="#e94d44"
            android:textStyle="bold"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#eee"
        android:layout_marginVertical="10dp"/>

    <!-- 订单商品列表（支持多商品） -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_order_goods"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- 收货地址 -->
    <TextView
        android:id="@+id/tv_address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="#666"
        android:layout_marginTop="10dp"/>

    <!-- 订单总价 -->
    <TextView
        android:id="@+id/tv_total_price"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="#e94d44"
        android:layout_marginTop="5dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#eee"
        android:layout_marginVertical="10dp"/>

    <!-- 支付方式 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/iv_pay_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"/>

        <TextView
            android:id="@+id/tv_pay_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textColor="#666"
            android:layout_marginLeft="8dp"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#eee"
        android:layout_marginVertical="10dp"/>

    <!-- 操作按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="right">

        <Button
            android:id="@+id/btn_action1"
            android:layout_width="120dp"
            android:layout_height="55dp"
            android:backgroundTint="#FFFFFF"
            android:textColor="#666"
            android:textSize="16sp"
            android:layout_marginHorizontal="4dp"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btn_action2"
            android:layout_width="120dp"
            android:layout_height="55dp"
            android:backgroundTint="#FFFFFF"
            android:textColor="#666"
            android:textSize="16sp"
            android:layout_marginHorizontal="4dp"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btn_action3"
            android:layout_width="120dp"
            android:layout_height="55dp"
            android:backgroundTint="#e94d44"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginHorizontal="4dp"
            android:visibility="gone"/>
    </LinearLayout>

</LinearLayout>