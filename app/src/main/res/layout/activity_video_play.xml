<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#000000">

    <!-- ExoPlayer播放器（全屏占满） -->
    <com.google.android.exoplayer2.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/ll_bottom_bar"
        app:show_buffering="always"
        app:use_controller="true"/>

    <!-- 左上角返回按钮 -->
    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="40dp"
        android:padding="10dp"
        android:src="@drawable/ic_back_white" />

    <!-- 左上角集数显示 -->
    <TextView
        android:id="@+id/tv_episode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="70dp"
        android:layout_marginTop="45dp"
        android:text="第1集"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"/>

    <!-- 底部栏（选集+简介） -->
    <LinearLayout
        android:id="@+id/ll_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#1A000000"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/ll_select_episode"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:gravity="center_vertical"
            android:paddingLeft="15dp"
            android:paddingRight="15dp">

            <TextView
                android:id="@+id/tv_select_episode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="选集 | 全52集"
                android:textColor="#FFFFFF"
                android:textSize="16sp"/>

            <ImageView
                android:id="@+id/iv_arrow"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginLeft="8dp"
                android:src="@drawable/ic_up_whitew"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_intro_collapse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="15dp"
            android:paddingRight="15dp"
            android:paddingBottom="10dp"
            android:text="赤凤殿主苏傲雪为让父母安心，接受陈松年推荐与唐清威订婚... 展开"
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            android:maxLines="2"/>
    </LinearLayout>

    <!-- ===================== 修复：底部弹出弹窗容器 ===================== -->
    <!-- 全屏半透明遮罩 -->
    <FrameLayout
        android:id="@+id/fl_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone">

        <!-- 真正的弹窗：底部对齐 + 高度80% -->
        <LinearLayout
            android:id="@+id/ll_episode_popup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#222222"
            android:orientation="vertical"
            android:layout_alignParentBottom="true"> <!-- RelativeLayout 底部对齐核心代码 -->

            <!-- 标题栏 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="#222222"
                android:gravity="center_vertical"
                android:paddingLeft="15dp">

                <TextView
                    android:id="@+id/tv_popup_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="回归后，未婚夫为我办葬礼"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <ImageView
                    android:id="@+id/iv_close_popup"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="10dp"
                    android:src="@drawable/ic_close_white"/>
            </LinearLayout>

            <!-- 简介 -->
            <TextView
                android:id="@+id/tv_intro_expand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="15dp"
                android:textColor="#CCCCCC"
                android:textSize="14sp"/>

            <!-- 集数列表 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_episode_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="15dp"/>
        </LinearLayout>
    </FrameLayout>

</RelativeLayout>