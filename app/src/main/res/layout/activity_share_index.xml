<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.share.ShareIndexActivity"
    android:fitsSystemWindows="true">

    <!-- 返回按钮 + 标题栏 -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/shape_background"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginLeft="10dp"
            android:background="@drawable/ic_arrow_left"
            android:backgroundTint="#ffffff"
            app:tint="#ffffff" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="分享统计"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textStyle="bold" />
    </androidx.appcompat.widget.Toolbar>

    <!-- 分段器(TabLayout)：移除无效tabTextSize属性，代码控制字号22sp -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@null"
        android:elevation="0dp"
        android:outlineProvider="none"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:tabGravity="fill"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/blue"
        app:tabTextColor="@color/gray"
        app:tabIndicatorColor="@color/blue"
        app:tabIndicatorHeight="2dp"
        app:tabBackground="@null">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="推荐" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="接点" />

    </com.google.android.material.tabs.TabLayout>

    <!-- 统计宫格布局 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_stats"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginTop="20dp"
        android:background="#ffffff"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        app:layout_constraintTop_toBottomOf="@id/tab_layout">

        <!-- 推荐人/接点人 -->
        <LinearLayout
            android:id="@+id/item_shareUserName"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_rounded_left_top_bottom"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            app:layout_constraintWidth_percent="0.24"
            app:layout_constraintHeight_percent="0.95"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/shape_avatar_border"
                android:padding="2dp"
                android:src="@drawable/ic_share_user" />

            <TextView
                android:id="@+id/tv_shareContext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="推荐人"
                android:textSize="16sp"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/tv_shareUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="智灵云(Rufiyaa)"
                android:textSize="14sp"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textAlignment="center"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

        <!-- 推荐人数 -->
        <LinearLayout
            android:id="@+id/item_shareUserCounts"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_rounded"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            app:layout_constraintWidth_percent="0.24"
            app:layout_constraintHeight_percent="0.95"
            app:layout_constraintStart_toEndOf="@id/item_shareUserName"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/shape_avatar_border"
                android:padding="2dp"
                android:src="@drawable/ic_share_share" />

            <TextView
                android:id="@+id/tv_shareDetailsContext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="推荐人数"
                android:textSize="16sp"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/tv_shareUserCounts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="14sp"
                android:textColor="#000000"
                android:textStyle="bold"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

        <!-- 团队人数 -->
        <LinearLayout
            android:id="@+id/item_teamUserCounts"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_rounded"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            app:layout_constraintWidth_percent="0.24"
            app:layout_constraintHeight_percent="0.95"
            app:layout_constraintStart_toEndOf="@id/item_shareUserCounts"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/shape_avatar_border"
                android:padding="2dp"
                android:src="@drawable/ic_share_team" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="团队人数"
                android:textSize="16sp"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/tv_teamUserCounts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="14sp"
                android:textColor="#000000"
                android:textStyle="bold"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

        <!-- 团队业绩 -->
        <LinearLayout
            android:id="@+id/item_teamTotal"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_rounded_right_top_bottom"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            app:layout_constraintWidth_percent="0.23"
            app:layout_constraintHeight_percent="0.95"
            app:layout_constraintStart_toEndOf="@id/item_teamUserCounts"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/shape_avatar_border"
                android:padding="2dp"
                android:src="@drawable/ic_total_max" />

            <TextView
                android:id="@+id/tv_max_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="团队业绩"
                android:textSize="16sp"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/tv_teamTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="14sp"
                android:textColor="#000000"
                android:textStyle="bold"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 搜索框 -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/layout_stats">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="输入账号或用户名搜索"
            android:background="@drawable/shape_search_bg"
            android:imeOptions="actionSearch"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_share_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/til_search" />

    <!-- 加载更多提示 -->
    <TextView
        android:id="@+id/tv_load_more"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center"
        android:text="加载更多..."
        android:textColor="@android:color/darker_gray"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/rv_share_list" />

</androidx.constraintlayout.widget.ConstraintLayout>